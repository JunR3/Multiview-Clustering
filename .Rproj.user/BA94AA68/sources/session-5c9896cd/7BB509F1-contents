library(dplyr)
library(Rcpp)

Rcpp::sourceCpp("multiview_gibbs.cpp")

# -------------------------
# 1) Loader: one hospital
# -------------------------
load_one_hospital <- function(csv_path,
                              hospital_id,
                              scale_continuous = TRUE) {
  df <- read.csv(csv_path)
  
  # pulizia base
  df <- df %>%
    select(-any_of(c("Unnamed..0", "Unnamed: 0"))) %>%  # gestisce entrambe le versioni del nome
    mutate(hosp = as.integer(hosp))
  
  # filtra ospedale
  df_h <- df %>% filter(hosp == hospital_id)
  
  if (nrow(df_h) == 0) {
    stop(paste0("Nessuna riga trovata per hosp = ", hospital_id,
                ". Controlla i valori disponibili con unique(df$hosp)."))
  }
  
  # variabili (adatta qui se vuoi cambiare views)
  # Qui faccio 4 views = 4 variabili (minimo indispensabile per far girare l'algoritmo)
  x <- df_h %>% select(smoke, gest, dde, weight)
  
  # smoke è tipicamente binaria -> la lascio così
  # le altre (continue) posso standardizzarle per stabilità numerica
  if (scale_continuous) {
    cont_vars <- c("gest", "dde", "weight")
    x[cont_vars] <- lapply(x[cont_vars], function(z) as.numeric(scale(z)))
    x$smoke <- as.numeric(x$smoke)
  } else {
    x <- mutate(x, across(everything(), as.numeric))
  }
  
  data_views <- list(
    as.vector(x$smoke),   # View 1
    as.vector(x$gest),    # View 2
    as.vector(x$dde),     # View 3
    as.vector(x$weight)   # View 4
  )
  
  list(
    df_h = df_h,
    x = x,
    data_views = data_views
  )
}

# -------------------------
# 2) Extract final clusters (come nel tuo script)
# -------------------------
get_final_clusters <- function(res_gibbs) {
  last_iter_idx <- length(res_gibbs$table_of)
  raw_tables <- res_gibbs$table_of[[last_iter_idx]]
  raw_dishes <- res_gibbs$dish_of[[last_iter_idx]]
  
  tables_r_index <- raw_tables + 1
  n_customers <- length(tables_r_index)
  n_views     <- length(raw_dishes)
  
  cluster_matrix <- matrix(NA, nrow = n_customers, ncol = n_views)
  colnames(cluster_matrix) <- paste0("View_", 1:n_views)
  
  for (v in 1:n_views) {
    dishes_for_view <- raw_dishes[[v]]
    cluster_matrix[, v] <- dishes_for_view[tables_r_index]
  }
  cluster_matrix
}

# -------------------------
# 3) Run wrapper: one hospital
# -------------------------
run_one_hospital <- function(csv_path,
                             hospital_id,
                             nsim = 10000,
                             burn_in = 9000,
                             thin = 1,
                             seed = 1999) {
  set.seed(seed)
  
  obj <- load_one_hospital(csv_path, hospital_id, scale_continuous = TRUE)
  
  res_gibbs <- run_gibbs_cpp(
    data_views = obj$data_views,
    M = nsim,
    burn_in = burn_in,
    thin = thin
  )
  
  clusters <- get_final_clusters(res_gibbs)
  
  list(
    hospital_id = hospital_id,
    n = nrow(obj$x),
    data_views = obj$data_views,
    res_gibbs = res_gibbs,
    clusters = clusters,
    raw_df = obj$df_h
  )
}

